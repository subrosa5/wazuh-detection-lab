<!--
  Detection: Credential Access via LSASS Memory Read (Sysmon Event ID 10)
  MITRE ATT&CK: T1003.001 (OS Credential Dumping: LSASS Memory)

  Parent condition relies on Wazuh's default Sysmon ruleset group
  `sysmon_event_10` (wazuh-ruleset rules/0330-sysmon_rules.xml, upstream
  rule 185008 at time of writing). Group names have drifted across Wazuh
  releases before (e.g. sysmon_event8 vs sysmon_event_8 - note the
  inconsistent underscore even within one version). Do not trust this
  blindly: tests/run_tests.py exercises every sample in tests/samples/
  against a live wazuh-manager container on every push specifically to
  catch drift like this before it reaches production. If CI goes red here
  after a Wazuh upgrade, check the parent group name first.

  Sibling ordering: Wazuh evaluates children of the same parent in
  descending `level` order and stops at the first match. We rely on that
  (100912 checked before 100913 before 100911) but make it irrelevant by
  also negating the allow-list explicitly in 100912/100913 - so behavior
  is correct even if a future Wazuh version changes sibling-evaluation
  order. Explicit beats implicit for a rule that pages someone at 2am.

  GrantedAccess masks in 100912 are the well-documented Mimikatz
  (sekurlsa, 0x1010) and ProcDump/Task Manager-style (0x1400-0x1410,
  0x1438/0x143a) full/partial memory-read access masks (see
  docs/detections/100910-lsass-credential-access.md for sources and the
  known-FP discussion - 0x1410 in particular is also emitted by a manual,
  legitimate ProcDump/Task Manager dump and needs environment-specific
  tuning, not blind trust).
-->
<group name="local,credential_access,windows,sysmon,">

  <rule id="100910" level="3">
    <if_group>sysmon_event_10</if_group>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)\\lsass\.exe$</field>
    <options>no_full_log</options>
    <description>Sysmon: process opened a handle to lsass.exe ($(win.eventdata.sourceImage) -> $(win.eventdata.targetImage))</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>lsass_access,</group>
  </rule>

  <rule id="100912" level="12">
    <if_sid>100910</if_sid>
    <field name="win.eventdata.grantedAccess" type="pcre2">(?i)^0x(1010|1038|1400|1410|1438|143a|1fffff)$</field>
    <list field="win.eventdata.sourceImage" lookup="match_key" negate="yes">etc/lists/lsass-access-allowlist</list>
    <description>Possible credential dumping: $(win.eventdata.sourceImage) opened lsass.exe with GrantedAccess=$(win.eventdata.grantedAccess) (mask consistent with Mimikatz/ProcDump-style memory read)</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>lsass_access,credential_dumping,</group>
  </rule>

  <rule id="100913" level="6">
    <if_sid>100910</if_sid>
    <list field="win.eventdata.sourceImage" lookup="match_key" negate="yes">etc/lists/lsass-access-allowlist</list>
    <description>Unrecognized process accessed lsass.exe: $(win.eventdata.sourceImage) (GrantedAccess=$(win.eventdata.grantedAccess)) - not a known dumping mask, review</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>lsass_access,</group>
  </rule>

  <rule id="100911" level="0">
    <if_sid>100910</if_sid>
    <list field="win.eventdata.sourceImage" lookup="match_key">etc/lists/lsass-access-allowlist</list>
    <options>no_full_log</options>
    <description>LSASS access by allow-listed process $(win.eventdata.sourceImage) - suppressed</description>
  </rule>

</group>
