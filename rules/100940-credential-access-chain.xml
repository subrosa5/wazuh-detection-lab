<!--
  Detection: Multi-Stage Credential Access Chain (correlation rule)
  MITRE ATT&CK: T1055 -> T1003.001 -> T1059.001

  This is the flagship rule of the repo: instead of alerting on isolated
  atomic events, it correlates three independent detections
  (process injection -> LSASS memory access -> suspicious PowerShell)
  into one high-confidence, host-scoped incident using <if_matched_sid>.

  Design note on <if_matched_sid> + <if_sid> together: <if_sid> requires
  the CURRENT log to itself match that rule's chain; <if_matched_sid>
  requires the referenced rule to have fired previously within
  `timeframe`, on ANY log. Combining them (as below) means: "this specific
  incoming event independently matches rule X, AND rule Y already fired
  earlier in the window" - which is exactly "B happened, and A happened
  before it". `timeframe` alone (no `frequency`) means "at least once in
  the window", not "N times" - frequency is intentionally omitted here.

  tests/samples/100940_chain_*.json encodes the three stages with
  synthetic timestamps 30-90s apart so the CI pipeline doesn't need to
  sleep for real wall-clock minutes to prove the chain fires.
-->
<group name="local,credential_access,windows,sysmon,powershell,">

  <!-- Stage 2: injection (100921) already seen, THIS event is a
       dumping-consistent LSASS access (100912), same host, within 5 min -->
  <rule id="100941" level="13" timeframe="300">
    <if_sid>100912</if_sid>
    <if_matched_sid>100921</if_matched_sid>
    <description>Credential access chain: process injection (rule 100921) followed by LSASS memory access (rule 100912) on the same host within 5 minutes - high-confidence credential dumping</description>
    <mitre>
      <id>T1055</id>
      <id>T1003.001</id>
    </mitre>
    <group>credential_access_chain,attack_chain,</group>
  </rule>

  <!-- Stage 3: the chain above already fired, THIS event is a suspicious
       PowerShell scriptblock (100931, e.g. exfil/C2 staging), within a
       further 5 minutes -->
  <rule id="100942" level="15" timeframe="300">
    <if_sid>100931</if_sid>
    <if_matched_sid>100941</if_matched_sid>
    <description>Full credential access + staging chain: injection -> LSASS dump -> suspicious PowerShell on the same host - treat as active incident</description>
    <mitre>
      <id>T1055</id>
      <id>T1003.001</id>
      <id>T1059.001</id>
    </mitre>
    <group>credential_access_chain,attack_chain,incident,</group>
  </rule>

</group>
