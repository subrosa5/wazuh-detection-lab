<!--
  Detection: Process Injection via Remote Thread Creation (Sysmon Event ID 8)
  MITRE ATT&CK: T1055 (Process Injection), T1055.001 (DLL Injection / shellcode)

  Parent condition relies on group `sysmon_event8` (no underscore - unlike
  sysmon_event_10, see 100910-lsass-credential-access.xml). Verified via
  tests/run_tests.py, not assumed.
-->
<group name="local,defense_evasion,windows,sysmon,">

  <rule id="100920" level="3">
    <if_group>sysmon_event8</if_group>
    <options>no_full_log</options>
    <description>Sysmon: remote thread created ($(win.eventdata.sourceImage) -> $(win.eventdata.targetImage))</description>
    <mitre>
      <id>T1055</id>
    </mitre>
    <group>process_injection,</group>
  </rule>

  <!-- Classic reflective/manually-mapped shellcode indicator: the thread's
       start address has no backing module on disk -->
  <rule id="100921" level="11">
    <if_sid>100920</if_sid>
    <field name="win.eventdata.startModule">^$</field>
    <description>Possible shellcode injection: $(win.eventdata.sourceImage) created a remote thread in $(win.eventdata.targetImage) with no backing module (StartAddress=$(win.eventdata.startAddress))</description>
    <mitre>
      <id>T1055.001</id>
    </mitre>
    <group>process_injection,shellcode,</group>
  </rule>

  <rule id="100922" level="9">
    <if_sid>100920</if_sid>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)\\(lsass|winlogon|csrss|services|svchost)\.exe$</field>
    <description>Remote thread created in a sensitive system process: $(win.eventdata.sourceImage) -> $(win.eventdata.targetImage)</description>
    <mitre>
      <id>T1055</id>
    </mitre>
    <group>process_injection,</group>
  </rule>

</group>
